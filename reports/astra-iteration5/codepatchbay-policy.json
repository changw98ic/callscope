        "expected": {
          "kind": "member",
          "object": {
            "kind": "reference",
            "name": "parsed"
          },
          "property": "retries"
        }
      },
      "transport": {
        "kind": "external_contract",
        "conditions": [
          "比较限定 pipeline 提交经默认队列、assignment、inbox 到受管理 worker 的正常执行分支；finalizer-only 分支不运行所选调用。",
          "enqueue 未复用旧 pending 项，metadata 经 resolveAgentsForEntry、assignment 构造及持久消息仍对应本次请求；这些中间传递尚未由本检查器自动证明。",
          "消费者调用的动态桥接目标与默认生产接入相符；调用选择器只匹配源码调用表达式，不证明动态导入或函数执行成功。"
        ]
      },
      "provenance": {
        "authority": "independent_review",
        "reviewer": "Astra",
        "author_approved": false,
        "source_doc": "/workspace/callscope/reports/astra-baseline/CODEPATCHBAY_ANALYSIS.md",
        "note": "CPB-01 的有限源码来源形式复核；中间传输与生产适用性作为显式前提，保留未知。"
      },
      "applicability": {
        "kind": "conditional",
        "conditions": [
          "比较限定 pipeline 提交经默认队列、assignment、inbox 到受管理 worker 的正常执行分支；finalizer-only 分支不运行所选调用。",
          "enqueue 未复用旧 pending 项，metadata 经 resolveAgentsForEntry、assignment 构造及持久消息仍对应本次请求；这些中间传递尚未由本检查器自动证明。",
          "消费者调用的动态桥接目标与默认生产接入相符；调用选择器只匹配源码调用表达式，不证明动态导入或函数执行成功。",
          "本合同要求消费者以 metadata.maxRetries 的来源形式构造该字段；源码表达式差异不证明某次运行数值不同，也不证明完整重试语义失效。"
        ],
        "counterexamples": [
          "用户输入恰好为 3 时，两个来源形式仍不同，但本次运行值可能相同。",
          "另有 queue failure budget、phase retry 和 DAG node retry；本合同不把它们当成同一预算或证明其失效。",
          "源表达式经等价别名、默认或转换仍可能正确，未证明语义等价不能把不同 AST 直接判成值错误。"
        ]
      },
      "source_evidence": [
        {
          "file": "cli/commands/pipeline.ts",
          "symbol": "parseCommonFlags",
          "node_type": "assignment_expression",
          "text": "retries = parseInt(args[++i], 10) || 3",
          "role": "context"
        },
        {
          "file": "runtime/worker/managed-worker.ts",
          "symbol": "main.processInbox",
          "node_type": "variable_declarator",
          "text": "metadata = assignment.metadata || {}",
          "role": "context"
        }
      ]
    }
  ],
