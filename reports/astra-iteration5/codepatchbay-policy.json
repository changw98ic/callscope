  "static_contracts": [
    {
      "id": "cpb-astra-terminal-initializer-members",
      "type": "literal_set_consistency",
      "severity": "medium",
      "reference": {
        "file": "server/services/event/event-materializer.ts",
        "symbol": "TERMINAL_STATUSES",
        "site": "initializer"
      },
      "subject": {
        "file": "server/services/job/job-store.ts",
        "symbol": "TERMINAL_STATUSES",
        "site": "initializer"
      },
      "relation": "equal",
      "provenance": {
        "authority": "independent_review",
        "reviewer": "Astra",
        "author_approved": false,
        "source_doc": "/workspace/callscope/reports/astra-baseline/CODEPATCHBAY_ANALYSIS.md",
        "note": "Astra 的终态集合一致性观察；此规则只把明确配置的两个声明初始化字符串成员集合设为相等合同，不按同名自动推断业务等价。"
      },
      "applicability": {
        "kind": "unconditional",
        "conditions": [
          "合同仅比较这两个已配置声明初始化中的封闭字符串成员集合，忽略元素顺序与重复成员。",
          "未证明运行时 Set 永不修改、全局内建构造器永不替换或所有终态写入合法。"
        ],
        "counterexamples": [
          "terminal 与 recoverable 是不同职责；本初始化集合规则不能据成员差推断所有恢复分支都错误。",
          "出现别名、展开、非字面元素或未知构造器绑定时保留未知，不把可见部分当成完整集合。"
        ]
      }
    }
  ],
  "evaluation": {
    "purpose": "Check CallScope against manually read source witnesses, not judge repository defects",
    "target_root": "/workspace/codepatchbay",
    "scope": "TypeScript and Python source captured from the full project root with explicit exclusions; scripts retained as source data; Shell remains unsupported",
    "target_execution_allowed": false,
    "repository_commands_allowed": false,
    "rules_are_repository_approved_contracts": false,
    "entrypoints_are_review_selection_not_complete_runtime_catalog": true,
    "no_finding_does_not_prove_business_or_runtime_correctness": true
