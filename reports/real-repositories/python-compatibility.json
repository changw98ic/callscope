    "files": [
      {
        "path": "app/__init__.py",
        "hash": "5e3fb4230c066a267b132792926cca2634f9c04654b21535f4b809ef77132dd4",
        "content": "\"\"\"供 CallScope 只读分析的订单模块示例，不是运行或测试入口。\"\"\"\n",
        "status": "parsed",
        "language": "python",
        "error": null,
        "module": "app"
      },
      {
        "path": "app/api.py",
        "hash": "4624ede911b332cbecce8d696668e0c90e7b151f3d145f73815ecc844d41353c",
        "content": "\"\"\"入口与配置中的调用结构约束配套；本文件不会被分析器执行。\"\"\"\n\nfrom app.domain import save_order\nfrom app.storage import read_order\n\n\ndef submit_order(order_id: str, payload: dict[str, object]) -> str:\n    \"\"\"示例缺口：validate_order 已存在，入口没有连接到它。\"\"\"\n    return save_order(order_id, payload)\n\n\ndef fetch_order(order_id: str) -> dict[str, object]:\n    \"\"\"示例缺口：绕过 get_order，直接调用了配置禁止的存储入口。\"\"\"\n    return read_order(order_id)\n",
        "status": "parsed",
        "language": "python",
        "error": null,
        "module": "app.api"
      },
      {
        "path": "app/domain.py",
        "hash": "91b427e1e04d43e43405ca9d961f2d13f6d9e7af6a10e669b8742cdb835318ec",
        "content": "\"\"\"领域函数；这里只演示调用关系，不向分析器声明业务正确性。\"\"\"\n\nfrom app.notifications import retry_notification\nfrom app.storage import read_order, write_order\n\n\ndef validate_order(payload: dict[str, object]) -> bool:\n    \"\"\"存在实现不意味着调用链已经接入，也不证明其业务逻辑正确。\"\"\"\n    return \"items\" in payload\n\n\ndef save_order(order_id: str, payload: dict[str, object]) -> str:\n    return write_order(order_id, payload)\n\n\ndef get_order(order_id: str) -> dict[str, object]:\n    return read_order(order_id)\n\n\ndef refresh_order(order_id: str, remaining: int) -> None:\n    \"\"\"与 retry_notification 组成调用环；含计数条件，环本身不是不终止证据。\"\"\"\n    if remaining <= 0:\n        return\n    retry_notification(order_id, remaining - 1)\n",
        "status": "parsed",
        "language": "python",
        "error": null,
        "module": "app.domain"
      },
      {
        "path": "app/notifications.py",
        "hash": "c09a2f30a166175d4a799418c017b4a7abcec2b97fc7e4ec616b19e9bb9f4a2f",
        "content": "\"\"\"通过模块引用形成调用环，避免在导入时读取未定义函数。\"\"\"\n\nimport app.domain as domain\n\n\ndef retry_notification(order_id: str, remaining: int) -> None:\n    if remaining <= 0:\n        return\n    domain.refresh_order(order_id, remaining - 1)\n",
        "status": "parsed",
        "language": "python",
        "error": null,
        "module": "app.notifications"
      },
      {
        "path": "app/plugins.py",
        "hash": "cabebe5d2134cbad7264ecb72cdaf426e2810f35c430e8e49b7f3b7e64dbb10f",
        "content": "\"\"\"动态回调示例：参数的具体调用目标不从源码猜测。\"\"\"\n\nfrom typing import Callable\n\n\ndef dispatch_hook(callback: Callable[[str], None], order_id: str) -> None:\n    callback(order_id)\n",
        "status": "parsed",
        "language": "python",
        "error": null,
        "module": "app.plugins"
      },
      {
        "path": "app/storage.py",
        "hash": "aae0b241583766ed9f4d1327c19442f319f8ee2c865a5bfef3063234a1706928",
        "content": "\"\"\"简单存储入口，仅供静态读取。\"\"\"\n\n_orders: dict[str, dict[str, object]] = {}\n\n\ndef write_order(order_id: str, payload: dict[str, object]) -> str:\n    _orders[order_id] = payload\n    return order_id\n\n\ndef read_order(order_id: str) -> dict[str, object]:\n    return _orders[order_id]\n",
        "status": "parsed",
        "language": "python",
        "error": null,
        "module": "app.storage"
      }
    ],
