{
  "schema_version": 1,
  "project": {
    "name": "CodePatchBay — static source review"
  },
  "analysis": {
    "languages": ["python", "typescript"],
    "source_roots": ["."],
    "module_aliases": {},
    "exclude": [
      ".git",
      ".beads",
      ".callscope",
      ".test-tmp",
      "node_modules",
      "third_party",
      "vendor",
      "generated",
      "dist",
      "dist-tests",
      "build",
      "coverage",
      "tests",
      "__tests__",
      "fixtures",
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/*.test.tsx",
      "**/*.spec.tsx"
    ],
    "max_file_bytes": 1048576
  },
  "layers": {},
  "entrypoints": [
    "ts:cli/cpb#main",
    "ts:cli/commands/fix#run",
    "ts:cli/commands/task#run",
    "ts:server/index#startHubServer",
    "ts:server/services/engine-runner#runJobWithServices"
  ],
  "rules": [
    {
      "id": "cpb-observed-cli-project-argument",
      "kind": "required_call",
      "from": "ts:cli/cpb#main",
      "to": "ts:cli/cpb#projectArgForCommand",
      "severity": "info",
      "description": "工具核对基准：main 的项目级命令分支中存在对 projectArgForCommand 的显式调用，不要求每次运行进入该分支。",
      "evaluation_only": true,
      "intent_basis": "source_observation",
      "source_locations": ["cli/cpb.ts:167"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-task-result-rendering",
      "kind": "required_call",
      "from": "ts:cli/commands/task#renderTaskView",
      "to": "ts:cli/commands/task#humanResultLine",
      "severity": "info",
      "description": "工具核对基准：task 的展示函数复用 humanResultLine。仅核对源码显式连接，不核对输出语义。",
      "evaluation_only": true,
      "intent_basis": "source_observation_with_declared_shared_renderer",
      "source_locations": ["cli/commands/task.ts:172"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-fix-shared-result-renderer",
      "kind": "required_call",
      "from": "ts:cli/commands/fix#followTask",
      "to": "ts:cli/commands/task#humanResultLine",
      "severity": "info",
      "description": "工具核对基准：fix 的 follow 分支使用从 task.js 静态导入的 humanResultLine，核对 NodeNext .js 导入到 .ts 源码的绑定。",
      "evaluation_only": true,
      "intent_basis": "source_observation_with_declared_shared_renderer",
      "source_locations": ["cli/commands/fix.ts:61", "cli/commands/fix.ts:352"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-server-engine-delegation",
      "kind": "required_call",
      "from": "ts:server/services/engine-runner#runJobWithServices",
      "to": "ts:core/engine/run-job#runJob",
      "severity": "info",
      "description": "工具核对基准：服务适配器构造依赖后直接调用 core 的 runJob；不验证注入端口具体实现或执行行为。",
      "evaluation_only": true,
      "intent_basis": "source_observation",
      "source_locations": ["server/services/engine-runner.ts:2", "server/services/engine-runner.ts:157"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-runjob-crash-wrapper",
      "kind": "required_call",
      "from": "ts:core/engine/run-job#runJob",
      "to": "ts:core/engine/run-job#runJobInner",
      "severity": "info",
      "description": "工具核对基准：runJob 的异常屏障包装直接调用同文件 runJobInner，不能据此保证异常恢复一定成功。",
      "evaluation_only": true,
      "intent_basis": "source_observation",
      "source_locations": ["core/engine/run-job.ts:75"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-checklist-materialization",
      "kind": "required_call",
      "from": "ts:core/engine/run-job#runJobInner",
      "to": "ts:core/engine/run-job-checklist-dag#freezeChecklistAndMaterializeDag",
      "severity": "info",
      "description": "工具核对基准：runJobInner 包含冻结 checklist 并物化 DAG 的显式连接；不判断前置分支、顺序或 fail-closed 行为正确性。",
      "evaluation_only": true,
      "intent_basis": "source_observation_with_declared_execution_order",
      "source_locations": ["core/engine/run-job.ts:159"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-runjob-to-dag-path",
      "kind": "required_path",
      "from": "ts:core/engine/run-job#runJob",
      "to": "ts:core/engine/run-job-execute-dag#executeWorkflowDag",
      "severity": "info",
      "description": "工具核对基准：runJob → runJobInner → executeWorkflowDag 的两跳显式路径；该路径只表示静态结构可达。",
      "evaluation_only": true,
      "intent_basis": "source_observation",
      "source_locations": ["core/engine/run-job.ts:75", "core/engine/run-job.ts:177"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-observed-task-view-sanitization",
      "kind": "required_call",
      "from": "ts:server/services/task/task-view#projectTaskView",
      "to": "ts:core/contracts/task-view-fields#sanitizeTaskView",
      "severity": "info",
      "description": "工具核对基准：公开 TaskView 投影包含 sanitizeTaskView 调用。仓库声明此字段边界，但调用存在不证明所有输出或嵌套数据安全。",
      "evaluation_only": true,
      "intent_basis": "source_observation_with_declared_output_boundary",
      "source_locations": ["server/services/task/task-view.ts:53", "server/services/task/task-view.ts:708"],
      "expected_model_result": "connection_present"
    },
    {
      "id": "cpb-capability-dynamic-command-boundary",
      "kind": "required_path",
      "from": "ts:cli/cpb#main",
      "to": "ts:cli/commands/task#run",
      "severity": "info",
      "description": "能力边界核对项：CLI 根据 COMMANDS 和计算路径动态 import 后调用 mod.run。期望工具报告 uncertain；自设规则不是仓库缺陷或漏接命令的证据。",
      "evaluation_only": true,
      "intent_basis": "dynamic_dispatch_capability_probe_from_source",
      "source_locations": ["cli/cpb.ts:154", "cli/cpb.ts:186"],
      "expected_model_result": "uncertain"
    },
    {
      "id": "cpb-observed-pure-result-helper-no-engine-call",
      "kind": "forbidden_call",
      "from": "ts:cli/commands/task#humanResultLine",
      "to": "ts:core/engine/run-job#runJob",
      "severity": "info",
      "description": "负向工具核对基准：已读源码的纯结果文案 helper 没有直接调用 runJob。仅核对这两个已存在端点的直接边，不推广为整个 task 命令或传递依赖无副作用。",
      "evaluation_only": true,
      "intent_basis": "source_observed_absence",
      "source_locations": ["cli/commands/task.ts:141", "cli/commands/task.ts:142", "cli/commands/task.ts:65"],
      "expected_model_result": "forbidden_connection_absent"
    }
  ],
  "evaluation": {
    "purpose": "Check CallScope against manually read source witnesses, not judge repository defects",
    "target_root": "/workspace/codepatchbay",
    "scope": "TypeScript and Python source captured from the full project root with explicit exclusions; scripts retained as source data; Shell remains unsupported",
    "target_execution_allowed": false,
    "repository_commands_allowed": false,
    "rules_are_repository_approved_contracts": false,
    "entrypoints_are_review_selection_not_complete_runtime_catalog": true,
    "no_finding_does_not_prove_business_or_runtime_correctness": true
  }
}
