", "raw_prefix_bytes": 0, "start_byte": 11189, "end_byte": 11448, "original_file_start_byte": 11189, "original_file_end_byte": 11448, "source_hash": "8abe3a09afcf48aa46b9380f9955e6c9e3e0411c1b02a29a9d2b4f1d721ea1a9", "grammar": "typescript", "parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "span_hash": "9cfaa4f35135d510ff3ca1dc1402b974eb6ab190a8cbe09afb569d764273e6de", "source_line": "    if (attemptCount > maxRetries) {", "source_excerpt": "if (attemptCount > maxRetries) {\n      return {\n        action: \"mark_failed\",\n        reason: `${failure.kind} exceeded retry budget (${attemptCount}/${maxRetries + 1}): ${failure.reason}`,\n        retryable: false,\n        ...failureMetadata,\n      };\n    }", "source_excerpt_truncated": false, "semantic_parse_id": "10bcfeb3a4478a5585fbae30a2fb96559ff68d7af515e8eeafc382c0ae16c944", "parse_identity": {"semantic_source_version": "semantic-snapshot-sources-1", "semantic_parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "snapshot_id": "731ae3b53582e86de4c9c786c224fc99aa45154099b7738ce8652be0f5a3f336", "original_text_utf8_sha256": "8abe3a09afcf48aa46b9380f9955e6c9e3e0411c1b02a29a9d2b4f1d721ea1a9", "projection_version": "ts-syntax-projection-1", "projection_mode": "original", "derived_text_utf8_sha256": null, "coordinate_space": "captured_text_utf8", "raw_prefix_bytes": 0, "literal_authority": "original_saved_source_text_only", "position_map": "identity_utf8_bytes_and_line_columns"}}, "conditions": ["d49efb685a76debaa1b3b59d03182e4f:condition"], "guard_returns": [{"location": {"file": "server/orchestrator/failure-router.ts", "line": 266, "column": 7, "end_line": 271, "end_column": 9, "column_unit": "utf8_bytes", "column_base": 1, "coordinate_space": "captured_text_utf8", "raw_prefix_bytes": 0, "start_byte": 11228, "end_byte": 11442, "original_file_start_byte": 11228, "original_file_end_byte": 11442, "source_hash": "8abe3a09afcf48aa46b9380f9955e6c9e3e0411c1b02a29a9d2b4f1d721ea1a9", "grammar": "typescript", "parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "span_hash": "96d7c97329c6118a8111bdd906810df06dfd76c714ca7524f09f57c292d91ca9", "source_line": "      return {", "source_excerpt": "return {\n        action: \"mark_failed\",\n        reason: `${failure.kind} exceeded retry budget (${attemptCount}/${maxRetries + 1}): ${failure.reason}`,\n        retryable: false,\n        ...failureMetadata,\n      };", "source_excerpt_truncated": false, "semantic_parse_id": "10bcfeb3a4478a5585fbae30a2fb96559ff68d7af515e8eeafc382c0ae16c944", "parse_identity": {"semantic_source_version": "semantic-snapshot-sources-1", "semantic_parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "snapshot_id": "731ae3b53582e86de4c9c786c224fc99aa45154099b7738ce8652be0f5a3f336", "original_text_utf8_sha256": "8abe3a09afcf48aa46b9380f9955e6c9e3e0411c1b02a29a9d2b4f1d721ea1a9", "projection_version": "ts-syntax-projection-1", "projection_mode": "original", "derived_text_utf8_sha256": null, "coordinate_space": "captured_text_utf8", "raw_prefix_bytes": 0, "literal_authority": "original_saved_source_text_only", "position_map": "identity_utf8_bytes_and_line_columns"}}, "value_id": "d7c8201dc7a7c95e64cc246846051e39"}], "lexical_owner_location": {"file": "server/orchestrator/failure-router.ts", "line": 103, "column": 3, "end_line": 364, "end_column": 4, "column_unit": "utf8_bytes", "column_base": 1, "coordinate_space": "captured_text_utf8", "raw_prefix_bytes": 0, "start_byte": 3872, "end_byte": 14840, "original_file_start_byte": 3872, "original_file_end_byte": 14840, "source_hash": "8abe3a09afcf48aa46b9380f9955e6c9e3e0411c1b02a29a9d2b4f1d721ea1a9", "grammar": "typescript", "parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "span_hash": "ea1272eed61dc6283197bf55e47e217cdb169b0c6c698c21e7cafb61fee48afe", "source_line": "  async route({ assignment, attempt, result }: LooseRecord): Promise<LooseRecord> {", "source_excerpt": "async route({ assignment, attempt, result }: LooseRecord): Promise<LooseRecord> {\n    const assignmentRecord = recordValue(assignment);\n    const resultRecord = recordValue(result);\n    const jobResult = recordValue(resultRecord.jobResult);\n    const failure = recordValue(jobResult.failure || resultRecord.failure);\n    const failureCause = recordValue(failure.cause);\n    const solverFailure = recordValue(failureCause.solver);\n    const failureKind = String(failure.kind || \"\");\n    const attemptCount = typeof assignmentRecord.attempts === \"number\" ? assignmentRecord.attempts : 0;\n    const maxRetries = MAX_RETRIES[failureKind] ?? 0;\n    const sourceContext = recordValue(assignmentRecord.sourceContext || recordValue(assignmentRecord.metadata).sourceContext);\n    const previousRetry = recordValue(sourceContext.retry);\n    const previousFingerprint = typeof previousRetry.failureFingerprint === \"string\" ? previousRetry.failureFingerprint : null;\n    const previousStrategy = typeof previousRetry.retryStrategy === \"string\" ? previousRetry.retryStrategy : null;\n    const initialRecovery = selectFailureRecovery({ failure, scope: \"queue\" });\n    const upstreamFingerprint = typeof solverFailure.failureFingerprint === \"string\"\n      ? solverFailure.failureFingerprint\n      : typeof failureCause.failureFingerprint === \"string\" ? failureCause.failureFingerprint : null;\n    const fingerprintRepeated = previousFingerprint === initialRecovery.failureFingerprint\n      || Boolean(upstreamFingerprint && previousFingerprint === upstreamFingerprint);\n    const normalizedPreviousFingerprint = fingerprintRepeated\n      ? initialRecovery.failureFingerprint\n      : previousFingerprint;\n    const recoveryFor = (preferredStrategy: string | null = null) => selectFailureRecovery({\n      failure,\n      previousFingerprint: normalizedPreviousFingerprint,\n      previousStrategy,\n      preferredStrategy,\n      scope: \"queue\",\n    });\n    const failureRecovery = recoveryFor(\n      solverFailure.exhausted === true ? \"fresh_session_diagnosis\" : null,\n    );\n    const failureMetadata = {\n      failureClass: failureRecovery.failureClass,\n      failureFingerprint: failureRecovery.failureFingerprint,\n      failureEvidence: failureRecovery.failureEvidence,\n    };\n    const retryDecision = (decision: LooseRecord, preferredStrategy: string | null = null): LooseRecord => {\n      if (fingerprintRepeated && !previousStrategy) {\n        return {\n          action: \"mark_failed\",\n          reason: `repeated unchanged failure ${initialRecovery.failureFingerprint} has no recorded prior strategy; blind retry denied`,\n          retryable: false,\n          ...failureMetadata,\n          retryStrategy: null,\n          strategyChanged: false,\n        };\n      }\n      const recovery = recoveryFor(preferredStrategy || (typeof decision.retryStrategy === \"string\" ? decision.retryStrategy : null));\n      if (!recovery.retryStrategy || !recovery.strategyChanged) {\n        return {\n          action: \"mark_failed\",\n          reason: recovery.stopReason || `retry strategy did not change for ${recovery.failureFingerprint}`,\n          retryable: false,\n          ...failureMetadata,\n          retryStrategy: recovery.retryStrategy,\n          strategyChanged: recovery.strategyChanged,\n        };\n      }\n      return {\n        ...decision,\n        failureClass: recovery.failureClass,\n        failureFingerprint: recovery.failureFingerprint,\n        failureEvidence: recovery.failureEvidence,\n        retryStrategy: recovery.retryStrategy,\n        strategyChanged: recovery.strategyChanged,\n        forceFreshSession: recovery.forceFreshSession,\n      };\n    };\n\n    if (\n      failure.retryable === false &&\n      failure.kind !== FailureKind.PLAN_BOUNDED_HANDOFF_TIMEOUT &&\n      failure.kind !== FailureKind.PERMISSION_DENIED &&\n      failure.ki