parseCommonFlags(args);\n  if (parsed.project) {\n    console.error(\"Usage: cpb pipeline <project> \\\"<task>\\\" [--retries <n>]\");\n    return 1;\n  }\n  const project = parsed.positional[0];\n  const task = parsed.positional.slice(1).join(\" \").trim();\n  if (!project || !task) {\n    console.error(\"Usage: cpb pipeline <project> \\\"<task>\\\" [--retries <n>]\");\n    return 1;\n  }\n\n  const hubRoot = process.env.CPB_HUB_ROOT || path.join(process.env.HOME || \".\", \".cpb\");\n\n  const { resolveTaskRoute } = await import(\"../../core/workflow/auto-route.js\");\n  const route = resolveTaskRoute({\n    task,\n    workflow: parsed.workflow,\n    planMode: parsed.planMode,\n    triageMode: parsed.triageMode,\n    workflowExplicit: parsed.workflowExplicit,\n    planModeExplicit: parsed.planModeExplicit,\n    actor: \"cli\",\n  } as LooseRecord);\n\n  const { enqueue } = await import(path.join(executorRoot, \"server\", \"services\", \"hub\", \"hub-queue.js\"));\n  const { getProject } = await import(path.join(executorRoot, \"server\", \"services\", \"hub\", \"hub-registry.js\"));\n\n  let registered;\n  try { registered = await getProject(hubRoot, project); } catch { registered = null; }\n\n  const entry = await enqueue(hubRoot, {\n    projectId: project,\n    sourcePath: registered?.sourcePath || null,\n    priority: \"P2\",\n    description: task,\n    type: \"cli_pipeline\",\n    metadata: {\n      source: \"cli\",\n      workflow: route.workflow,\n      planMode: route.planMode,\n      triageMode: parsed.triageMode,\n      routeDecision: route.decision || undefined,\n      actor: \"cli\",\n      autoFinalize: true,\n      agent: parsed.agent || undefined,\n      model: parsed.model || undefined,\n      maxRetries: parsed.retries,\n      issueNumber: parsed.issueNumber ? Number(parsed.issueNumber) : null,\n      issueUrl: parsed.issueUrl || null,\n      repo: parsed.repo || registered?.github?.fullName || null,\n      issueTitle: task,\n      requestedAt: new Date().toISOString(),\n      agents: buildAgentMetadata({\n        agent: parsed.agent,\n        planAgent: parsed.planAgent,\n        executeAgent: parsed.executeAgent,\n        verifyAgent: parsed.verifyAgent,\n        reviewAgent: parsed.reviewAgent,\n        planVariant: parsed.planVariant,\n        executeVariant: parsed.executeVariant,\n        verifyVariant: parsed.verifyVariant,\n        reviewVariant: parsed.reviewVariant,\n      }),\n    },\n  });\n\n  console.log(`Enqueued ${entry.id} (project=${project})`);\n  return 0;\n}", "source_excerpt_truncated": false, "semantic_parse_id": "872fc2ae5a8f2f736589f3702200e29b93487166b576c640ddc2cce2b648dfe6", "parse_identity": {"semantic_source_version": "semantic-snapshot-sources-1", "semantic_parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "snapshot_id": "731ae3b53582e86de4c9c786c224fc99aa45154099b7738ce8652be0f5a3f336", "original_text_utf8_sha256": "3df3f333ec4668352efde20049494c4a85bdf13049c808cd9f89f2d82f30b4ed", "projection_version": "ts-syntax-projection-1", "projection_mode": "original", "derived_text_utf8_sha256": null, "coordinate_space": "captured_text_utf8", "raw_prefix_bytes": 0, "literal_authority": "original_saved_source_text_only", "position_map": "identity_utf8_bytes_and_line_columns"}}, "parameter_index": null, "pattern_path": [{"kind": "object_property", "name": "enqueue"}], "import": null, "value": {"stable": false, "runtime_value_known": false, "reasons": ["destructuring_value_not_modeled", "write_and_effect_review_not_requested"], "model": "captured_declaration_identity_only", "heap_state_verified": false}, "gaps": [], "snapshot_id": "731ae3b53582e86de4c9c786c224fc99aa45154099b7738ce8652be0f5a3f336", "limitations": ["identity denotes a captured lexical declaration, not an object/resource or alias identity", "no reaching values, target activation, hidden calls or external heap mutation are proved", "write records include captured syntax and possible effects, 