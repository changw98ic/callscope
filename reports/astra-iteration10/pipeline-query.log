\n\nexport function shouldRetainWorkerWorktree(env: Record<string, string | undefined> = process.env): boolean {\n  return env[PRODUCT_VALIDATION_KEEP_WORKTREE_ENV] === \"1\";\n}\n\nfunction shouldExitWorkerOnIdle(env: Record<string, string | undefined> = process.env): boolean {\n  return env[WORKER_EXIT_ON_IDLE_ENV] === \"1\";\n}\n\nfunction workerIdleExitMs(env: Record<s", "source_excerpt_truncated": true, "semantic_parse_id": "34cbe4d67efaa08969fd98e01e76c7b1127c376e5ff07f4db3d697ed0e55742b", "parse_identity": {"semantic_source_version": "semantic-snapshot-sources-1", "semantic_parser_version": "tree-sitter-0.25.2+tree-sitter-typescript-0.23.2+cpython-3.12.14", "snapshot_id": "731ae3b53582e86de4c9c786c224fc99aa45154099b7738ce8652be0f5a3f336", "original_text_utf8_sha256": "75cdd41a20c71a7f0c7c500080ab7743417f932d35e4179a031b822831c633ca", "projection_version": "ts-syntax-projection-1", "projection_mode": "original", "derived_text_utf8_sha256": null, "coordinate_space": "captured_text_utf8", "raw_prefix_bytes": 0, "literal_authority": "original_saved_source_text_only", "position_map": "identity_utf8_bytes_and_line_columns"}}, "parameter_index": null, "pattern_path": [], "import": {"module": "../../shared/orchestrator/worker-store.js", "imported_name": "WorkerStore", "type_only": false, "provider_resolved": false}, "value": {"stable": false, "runtime_value_known": false, "reasons": ["write_and_effect_review_not_requested"], "model": "captured_declaration_identity_only", "heap_state_verified": false}, "gaps": [], "snapshot_id": "731ae3b53582e86de4c9c786c224fc99aa45154099b7738ce8652be0f5a3f336", "limitations": ["identity denotes a captured lexical declaration, not an object/resource or alias identity", "no reaching values, target activation, hidden calls or external heap mutation are proved", "write records include captured syntax and possible effects, not executed writes"], "identity_api_version": "captured-declaration-identity-only-1", "write_and_effect_review_perfo